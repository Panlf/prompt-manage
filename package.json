{
  "name": "prompt-manage",
  "version": "1.1.0",
  "type": "module",
  "description": "提示词管理桌面应用 - 基于 Electrobun + SQLite",
  "scripts": {
    "start": "electrobun dev",
    "dev": "electrobun dev --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "electrobun build --env=stable",
    "build:win": "electrobun build --env=stable --platform=win && bun run scripts/build-portable.ts",
    "build:portable": "bun run scripts/build-portable.ts",
    "build:mac": "electrobun build --env=stable --platform=mac",
    "build:linux": "electrobun build --env=stable --platform=linux",
    "build:all": "electrobun build --env=stable --all"
  },
  "dependencies": {
    "electrobun": "1.18.1"
  },
  "devDependencies": {
		"@types/bun": "1.3.14",
    "typescript": "^5.7.2",
    "rcedit": "^2.3.0"
  }
}
